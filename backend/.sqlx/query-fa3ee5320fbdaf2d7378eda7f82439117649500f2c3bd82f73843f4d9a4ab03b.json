{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            alert_point_id,\n            alert_type AS \"alert_type: AlertType\",\n            reason,\n            triggered_at,\n            resolved_at\n        FROM active_alerts\n        WHERE alert_point_id = $1 AND resolved_at IS NULL\n        ORDER BY triggered_at DESC, id DESC\n        LIMIT 1\n        ",
