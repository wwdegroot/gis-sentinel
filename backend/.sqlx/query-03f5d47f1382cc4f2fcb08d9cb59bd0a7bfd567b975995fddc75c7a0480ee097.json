  "query": "\n        INSERT INTO users (email, password_hash, role)\n        VALUES ($1, $2, 'admin')\n        ON CONFLICT (email) DO UPDATE\n            SET password_hash = EXCLUDED.password_hash,\n                role = 'admin'\n        RETURNING id, email, password_hash, role AS \"role: Role\", created_at, updated_at\n        ",
