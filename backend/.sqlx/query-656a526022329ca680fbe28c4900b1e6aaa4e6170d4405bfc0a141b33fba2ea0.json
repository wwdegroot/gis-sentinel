  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            timestamp,\n            response_time_ms,\n            status_code,\n            is_up,\n            error_message\n        FROM probe_results\n        WHERE alert_point_id = $1\n          AND is_up = false\n          AND timestamp > now() - make_interval(hours => $2)\n        ORDER BY timestamp DESC, id DESC\n        LIMIT $3\n        ",
