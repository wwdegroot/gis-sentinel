# GIS Sentinel backend configuration
# Copy this file to `.env` and adjust values.

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gis_sentinel

# Valkey/Redis connection string used for the probe job queue and alerts
# Pub/Sub channel (defaults to redis://127.0.0.1:6379).
REDIS_URL=redis://127.0.0.1:6379

# HTTP listener bind address/port (defaults: 0.0.0.0:3000).
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Tracing filter applied when RUST_LOG is not set.
LOG_LEVEL=info,tower_http=debug

# Build-time flag: when set, sqlx compile-time checked queries (query! macros)
# use the committed `.sqlx/` offline cache instead of a live database.
# Keep `true` for normal builds. Set to `false` (or unset) and point DATABASE_URL
# at a live DB while editing queries, then refresh the cache with:
#   cargo sqlx prepare -- --all-targets
SQLX_OFFLINE=true
APP_HOST=0.0.0.0
APP_PORT=3000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BUILD_DIR=frontend/build

# Scheduler (task 2.2): how often due targets are polled, in seconds.
SCHEDULER_TICK_SECONDS=5
# Default probe timeout in ms when a target configuration lacks one.
PROBE_TIMEOUT_MS_DEFAULT=10000
# Worker (task 2.3): parallel probe workers.
WORKER_CONCURRENCY=2
# Consecutive failing probes before an alert is raised (min 1).
PROBE_FAILURE_THRESHOLD=2

# ---- Authentication (Option B: session-cookie auth) ----
# Startup upsert of the first local admin. Set both to enable login; rotating
# the env value rotates the admin password on each boot.
# BOOTSTRAP_ADMIN_EMAIL=admin@gis-sentinel.local
# BOOTSTRAP_ADMIN_PASSWORD=change-me
# Session cookie name + Redis session TTL (seconds; default 7 days).
SESSION_COOKIE_NAME=sentinel_session
SESSION_TTL_SECONDS=604800
# Cookie attributes. COOKIE_SECURE must be `true` in prod (HTTPS).
# COOKIE_SAMESITE=strict|lax|none  (default strict)
COOKIE_SECURE=true
# COOKIE_DOMAIN=             (optional)

# ---- Option D (reverse-proxy / SSO) — opt-in, off by default ----
# When ENABLE_TRUSTED_PROXY_AUTH=true, an `X-Authenticated-User: <email>`
# header is honored ONLY when the request's peer IP == TRUSTED_PROXY_IP.
# The user must already exist in the `users` table (pre-provisioned).
# ENABLE_TRUSTED_PROXY_AUTH=false
# TRUSTED_PROXY_IP=127.0.0.1

